# ---------------------------------------------------------------------------
# Arva Scope-3 Projects Dashboard — environment variables
# Copy to `.env` for local dev. On Vercel, set these in Project Settings.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Local dev: a local Postgres or a Neon dev branch.
# On Vercel: the Neon integration injects DATABASE_URL automatically.
# Prisma uses DATABASE_URL for queries; if your provider offers a pooled URL,
# put the pooled URL in DATABASE_URL and the direct URL in DIRECT_URL.
DATABASE_URL="postgresql://user:password@localhost:5432/arva?schema=public"

# Direct (non-pooled) connection, used by `prisma migrate`. Optional locally.
# On Neon this is the "direct" connection string. Falls back to DATABASE_URL.
DIRECT_URL="postgresql://user:password@localhost:5432/arva?schema=public"

# Auth.js (NextAuth v5) session secret. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-generate-a-long-random-string"

# Single admin login (credentials provider).
ADMIN_EMAIL="admin@arvaintelligence.com"
# Password is compared in plain text against ADMIN_PASSWORD OR, if you prefer,
# set ADMIN_PASSWORD_HASH to a bcrypt hash and leave ADMIN_PASSWORD blank.
ADMIN_PASSWORD="change-me"
# Optional bcrypt hash alternative (takes precedence over ADMIN_PASSWORD if set).
# Generate: node -e "console.log(require('bcryptjs').hashSync('yourpassword',10))"
ADMIN_PASSWORD_HASH=""

# Stable user id assigned to the admin (ownership seam for future multi-user).
ADMIN_USER_ID="admin"
